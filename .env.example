NODE_ENV=production
PORT=5000
APP_NAME=OwoTrack

# Database
MONGODB_URI=
REDIS_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.7

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Korapay Payment Configuration ───────────────────────────────────────────
KORAPAY_MODE=test
KORAPAY_BASE_URL=https://api.korapay.com/merchant/api/v1
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
KORAPAY_WEBHOOK_SECRET=

# Subscription Plan Prices (in Naira)
KORAPAY_PLAN_GROWTH_MONTHLY=3000
KORAPAY_PLAN_PRO_MONTHLY=5000
KORAPAY_PLAN_BUSINESS_MONTHLY=10000

# ─── DEPRECATED: Flutterwave (replaced by Korapay 2026-05-16) ────────────────
# Keep until 2026-06-16 for rollback. Remove after that.
# FLW_SECRET_KEY=
# FLW_WEBHOOK_HASH=

# ─── SMS Provider ────────────────────────────────────────────────────────────
# Options: sendchamp | bulksms — change to bulksms to switch provider
SMS_PROVIDER=sendchamp

# ─── BulkSMS Nigeria ─────────────────────────────────────────────────────────
BULKSMS_BASE_URL=https://www.bulksmsnigeria.com/api/v2
BULKSMS_API_TOKEN=
BULKSMS_SENDER_ID=OwoTrack

# ─── SendChamp (OTP / SMS) ────────────────────────────────────────────────────
SENDCHAMP_BASE_URL=https://api.sendchamp.com/api/v1
SENDCHAMP_PUBLIC_KEY=
SENDCHAMP_SENDER_NAME=OwoTrack
SENDCHAMP_MODE=test
SENDCHAMP_OTP_EXPIRY_MINUTES=5
SENDCHAMP_OTP_LENGTH=6

# ─── DEPRECATED: Twilio (replaced by SendChamp 2026-05-16) ───────────────────
# FORCE_CONSOLE_OTP=false   <- use SENDCHAMP_MODE instead
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ─── SendGrid (Email) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@owotrack.com
SENDGRID_FROM_NAME=OwoTrack

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_EXPIRES_MINUTES=10

# Sentry
SENTRY_DSN=

# ─── Google Play Review Bypass ───────────────────────────────────────────────
# Bypass is ONLY active when BOTH vars are set. Remove both to disable after review.
TEST_REVIEW_PHONE=   # e.g. 08068745098
TEST_REVIEW_OTP=     # e.g. A3K9M2

# Expo
EXPO_PUBLIC_APP_KEY=
