NODE_ENV=production
PORT=5000
APP_NAME=OwoTrack

# Database
MONGODB_URI=

# Redis
REDIS_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.7

# Google Cloud (fallback STT)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_KEY_FILE=./google-credentials.json

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Flutterwave
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=

# ─── SendChamp (OTP / SMS) ───────────────────────────────────────────────────
SENDCHAMP_BASE_URL=https://api.sendchamp.com/api/v1
SENDCHAMP_PUBLIC_KEY=
SENDCHAMP_SENDER_NAME=OwoTrack
# "test" logs OTP to console and returns devOtp in the response (safe for dev/staging)
# "production" calls the real SendChamp API and sends actual SMS
SENDCHAMP_MODE=test
SENDCHAMP_OTP_EXPIRY_MINUTES=5
SENDCHAMP_OTP_LENGTH=6

# ─── Twilio (DEPRECATED — use SENDCHAMP_MODE instead) ───────────────────────
# DEPRECATED — use SENDCHAMP_MODE instead
# FORCE_CONSOLE_OTP=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid (Email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@owotrack.com
SENDGRID_FROM_NAME=OwoTrack

# Expo
EXPO_ACCESS_TOKEN=
EXPO_PUBLIC_APP_KEY=

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_EXPIRES_MINUTES=10

# Sentry
SENTRY_DSN=
